# =============================================================================
#  SAFunded — Environment variables
#  Copy this file to `.env.local` and fill in your REAL values.
#  Never commit `.env.local` or real keys to version control.
# =============================================================================

# --- Stripe ------------------------------------------------------------------
# Your Stripe SECRET key (server-side only). Starts with sk_test_ or sk_live_.
# >>> INSERT YOUR KEY HERE
STRIPE_SECRET_KEY=sk_test_xxx

# Your Stripe PUBLISHABLE key (safe to expose to the browser). Starts with pk_.
# (Not strictly required for hosted Checkout redirect, but kept for future use.)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Stripe Price IDs --------------------------------------------------------
# Create one Product + Price per account size in the Stripe Dashboard,
# then paste each Price ID (starts with price_) below.
# >>> INSERT YOUR PRICE IDs HERE
STRIPE_25K_PRICE_ID=price_xxx_25k
STRIPE_50K_PRICE_ID=price_xxx_50k
STRIPE_100K_PRICE_ID=price_xxx_100k

# Signing secret for the Stripe webhook endpoint (/api/stripe-webhook).
# Copy it from the Stripe Dashboard → Developers → Webhooks. Starts with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Confirmo (crypto payments) ----------------------------------------------
# API key for the Confirmo payment gateway (server-side only).
# Create it in the Confirmo dashboard. Without it, the crypto checkout button
# returns a friendly "not available" error and card checkout still works.
# >>> INSERT YOUR KEY HERE
CONFIRMO_API_KEY=
# Currency the invoice amount is quoted in (matches the USD display prices).
CONFIRMO_INVOICE_CURRENCY=USD
# Crypto currency you want to be settled in (e.g. BTC, USDC).
CONFIRMO_SETTLEMENT_CURRENCY=BTC
# Optional callback password used to verify Confirmo webhook signatures
# (/api/confirmo-webhook). If set, must match the password configured in Confirmo.
CONFIRMO_CALLBACK_PASSWORD=

# --- SMTP (order-confirmation e-mail) ----------------------------------------
# Server-side mailbox used to send the post-purchase confirmation e-mail
# (Bestätigungs-Mail / Widerrufsbelehrung). Never hardcode the password.
SMTP_HOST=smtp.webspace.bz
SMTP_PORT=587
SMTP_USER=info@safunded.com
# >>> SET THIS AS A SECRET IN NETLIFY — do not commit a real value.
SMTP_PASSWORD=
# Sender shown to the customer.
SMTP_FROM=info@safunded.com
SMTP_FROM_NAME=SAFunded

# --- Supabase ----------------------------------------------------------------
# Öffentliche Supabase-Zugangsdaten für die Kunden-Authentifizierung.
# Beide Werte sind für den Browser bestimmt (Prefix NEXT_PUBLIC_).
# Zu finden im Supabase-Dashboard unter Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service-role key (server-side only!) used by the webhook handlers to look up
# the customer e-mail and store the compliance proof. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- App ---------------------------------------------------------------------
# The public base URL of your app. Used to build success/cancel URLs.
# Local dev: http://localhost:3000   Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
